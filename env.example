# Server host and port
REFINED_AGY_HOST=127.0.0.1
REFINED_AGY_PORT=8787

# Optional API key for bearer auth (required if binding to non-loopback host)
# REFINED_AGY_API_KEY=your-secret-api-key

# Path to profiles JSON configuration
REFINED_AGY_PROFILES_FILE=./profiles.json

# Shutdown grace period in ms (default: 15000)
REFINED_AGY_SHUTDOWN_GRACE_MS=15000

# Responses registry configuration
REFINED_AGY_RESPONSE_REGISTRY_MAX_ENTRIES=1000
REFINED_AGY_RESPONSE_REGISTRY_TTL_MS=3600000
